    "fields": {
      "quantize": {
        "type": "integer",
        "maximum": 256,
        "minimum": -1,
        "title": "Quantize",
        "description": "Palette handling for the result. 0 auto-detects a palette, -1 keeps every color the downsample produces, and 2-256 quantizes to exactly that many colors.",
        "default": 0
