  {
    "route": "/reduce-colors",
    "verb": "post",
    "fields": {
      "palette_image": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Base64Image"
          },
          {
            "type": "null"
          }
        ],
        "description": "An image whose colors become the palette (max 256 colors). Use it to force frames onto an existing game palette. Mutually exclusive with num_colors."
      },
      "dithering": {
        "type": "string",
        "enum": [
          "none",
          "2x2",
          "4x4",
          "8x8"
        ],
        "title": "Dithering",
        "description": "Ordered dithering matrix size. Larger matrices give smoother gradients at the cost of a busier look.",
        "default": "none"
      },
      "dithering_strength": {
        "type": "number",
        "maximum": 10,
        "minimum": 0,
        "title": "Dithering Strength",
        "description": "How strongly to dither. Ignored when dithering is 'none'.",
        "default": 5
      }
    }
  },
