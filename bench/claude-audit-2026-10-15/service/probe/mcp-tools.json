  "reduceColors": {
    "name": "reduce_colors",
    "description": "Quantize images onto a smaller, shared palette.\n\nPixel art reads as pixel art partly because of its restricted palette. AI\noutput and converted artwork often carry hundreds of near-identical colors;\nthis snaps them onto a tight palette, optionally with ordered dithering.\n\nPassing several frames in one call is the point: they are quantized TOGETHER,\nso an animation or a character's eight directions come back sharing ONE\npalette instead of drifting apart frame by frame. Quantizing them one at a\ntime is the mistake this tool exists to prevent.\n\nThree ways to choose the palette:\n- omit num_colors and the palette image — the size is auto-detected\n- num_colors — quantize to exactly this many colors\n- palette_image — reuse the colors of an existing image (the game's palette)\n\nThe result carries a `palette` strip you can feed back as palette_image_base64\nto lock later frames onto the same colors.\n\nTotal size limit across all frames is 512x512 worth of pixels (sixteen 64x64\nframes, or four 128x128).\n\nCost: 0.1 generations. Runs locally in about a second — poll once with\nget_image(job_id).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "images_base64": {
          "default": null,
          "description": "Base64 PNG(s) to quantize — pass a one-element list for a single image. All frames must be the same size. PREFER image_urls; MCP clients routinely truncate large inline base64.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "image_urls": {
          "default": null,
          "description": "Alternative to images_base64: https, data: or `upload:<id>` (POST /v2/uploads with this same bearer token) URLs to the PNG(s), one per frame. PREFER THIS. Give urls OR base64, not both.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "num_colors": {
          "default": null,
          "description": "Target number of colors. Omit to auto-detect a good palette size from the images. Cannot be combined with a palette image.",
          "maximum": 256,
          "minimum": 2,
          "type": [
            "integer",
            "null"
          ]
        },
        "palette_image_base64": {
          "default": null,
          "description": "Base64 PNG whose colors become the palette (max 256 colors) — use it to force frames onto an existing game palette. Cannot be combined with num_colors.",
          "type": [
            "string",
            "null"
          ]
        },
        "palette_image_url": {
          "default": null,
          "description": "Alternative to palette_image_base64: an https (or data:) URL to the palette image. Give one, not both.",
          "type": [
            "string",
            "null"
          ]
        },
        "dithering": {
          "default": "none",
          "description": "Ordered dithering matrix size. Larger matrices give smoother gradients at the cost of a busier look.",
          "enum": [
            "none",
            "2x2",
            "4x4",
            "8x8"
          ],
          "type": "string"
        },
        "dithering_strength": {
          "default": 5,
          "description": "How strongly to dither. Ignored when dithering is 'none'.",
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        "project_id": {
          "default": null,
          "description": "Internal Game Builder project context; the finished image is linked after generation.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
